{
  "name": "cui",
  "type": "module",
  "version": "1.0.0",
  "main": "./dist/lib/index.js",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/types/index.d.ts",
      "import": "./dist/lib/index.js"
    }
  },
  "customElements": "dist/lib/custom-elements.json",
  "files": [
    "dist/lib"
  ],
  "sideEffects": true,
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "build:elements": "rollup -c rollup.elements.config.js",
    "build:lib": "rollup -c rollup.lib.config.js",
    "build:server": "rollup -c rollup.server.config.js",
    "build:types": "tsc -p tsconfig.build.json",
    "build:manifest": "cem analyze && tsx scripts/manifest-attrs.ts",
    "build": "npm run clean && npm run typecheck && npm run build:elements && npm run build:lib && npm run build:server && npm run build:types && npm run build:manifest",
    "watch:elements": "rollup -c rollup.elements.config.js -w",
    "watch:lib": "rollup -c rollup.lib.config.js -w",
    "watch:server": "rollup -c rollup.server.config.js -w",
    "dev": "node dist/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "fast-glob": "^3.3.3",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "rollup": "^4.67.4",
    "rollup-plugin-esbuild": "^6.2.1",
    "sass": "^1.108.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
